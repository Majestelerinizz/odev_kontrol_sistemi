# ─────────────────────────────────────────────────────────────────
# Ödev Takip Sistemi — Backend Ortam Değişkenleri
# Bu dosyayı kopyalayıp '.env' olarak kaydedin, değerleri doldurun.
# ─────────────────────────────────────────────────────────────────

# ── Sunucu Portu ───────────────────────────────────────────────
PORT=3001

# ── Docker (Yerel) PostgreSQL Bağlantısı ──────────────────────
# docker-compose.yml ile otomatik ayarlanır, değiştirmeyin
LOCAL_DATABASE_URL=postgresql://odevuser:odevpass123@localhost:5432/odevtakip

# ── Neon.com (Bulut) PostgreSQL Bağlantısı ────────────────────
# Neon.com → Dashboard → Connection Details → Connection string
# Örnek: postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/odevtakip?sslmode=require
NEON_DATABASE_URL=postgresql://KULLANICI:SIFRE@ep-xxx.neon.tech/odevtakip?sslmode=require

# ── Aktif Veritabanı Hedefi ────────────────────────────────────
# 'local'  → Docker PostgreSQL (geliştirme için)
# 'neon'   → Neon.com (üretim/yedek için)
# 'both'   → Her iki veritabanına eş zamanlı yaz (önerilir)
DB_TARGET=both

# ── Firebase Admin SDK ─────────────────────────────────────────
# Firebase Console → Proje Ayarları → Hizmet Hesapları → Yeni özel anahtar oluştur
# İndirilen JSON dosyasını backend/ klasörüne koyun
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Sync Ayarları ─────────────────────────────────────────────
# Realtime sync aktif mi? (true/false)
REALTIME_SYNC=true

# Sync log seviyesi: 'minimal' | 'verbose'
LOG_LEVEL=verbose

# ── Güvenlik ──────────────────────────────────────────────────
# API endpoint'lerini korumak için gizli anahtar (istediğiniz rastgele string)
API_SECRET_KEY=GIZLI_ANAHTAR_BURAYA

# Üretimde false/unset bırakın. true yalnızca yerel testlerde 123456 OTP'ye izin verir.
ALLOW_TEST_OTP=false

# ── Twilio (opsiyonel SMS) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Gemini AI Vision (opsiyonel) ──────────────────────────────
GEMINI_API_KEY=
