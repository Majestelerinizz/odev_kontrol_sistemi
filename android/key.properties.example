# Android Release Keystore Yapılandırma Örneği
# Bu dosyayı 'key.properties' olarak kopyalayın ve şifreleri doldurun:
# keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storePassword=ORNEK_STORE_SIFRESI
keyPassword=ORNEK_KEY_SIFRESI
keyAlias=upload
storeFile=../upload-keystore.jks
