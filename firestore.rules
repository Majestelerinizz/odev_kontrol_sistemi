rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }

    function isParent() {
      return isAuthenticated() && getUserRole() == 'parent';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isParentOfStudent(studentId) {
      return isParent() &&
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.parentIds;
    }

    function onlyOwnUidAddedToParentIds() {
      return request.resource.data.parentIds.hasAll(resource.data.parentIds) &&
        request.resource.data.parentIds.size() == resource.data.parentIds.size() + 1 &&
        request.auth.uid in request.resource.data.parentIds &&
        !(request.auth.uid in resource.data.parentIds);
    }

    function teacherOwnsCreate() {
      return isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }

    function teacherOwnsResource() {
      return isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    function parentStudentIds() {
      return get(/databases/$(database)/documents/parent_profiles/$(request.auth.uid))
        .data.get('studentIds', []);
    }

    /// Veli yalnızca kendi öğrencilerine atanmış ödevi okuyabilir (studentIds denormalize).
    function parentCanReadHomework() {
      return isParent() &&
        resource.data.keys().hasAny(['studentIds']) &&
        resource.data.studentIds.hasAny(parentStudentIds());
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role in ['teacher', 'parent'];
      allow update: if isOwner(uid) &&
        (!request.resource.data.keys().hasAny(['role']) ||
         request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /teacher_profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /parent_profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /classes/{classId} {
      allow read: if isAdmin() || teacherOwnsResource();
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        isParentOfStudent(studentId);
      allow create: if teacherOwnsCreate();
      allow update: if (teacherOwnsResource() &&
          request.resource.data.teacherId == resource.data.teacherId) ||
        (isParent() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds']) &&
          onlyOwnUidAddedToParentIds());
      allow delete: if teacherOwnsResource();
    }

    match /invite_codes/{code} {
      // Sınıf kodları (type=class): kayıt öncesi doğrulama için anonim get.
      // Eski öğrenci kodları: yalnızca kullanılmamışken anonim get.
      allow get: if resource.data.get('revoked', false) == false &&
        (
          resource.data.get('type', 'student') == 'class' ||
          resource.data.used == false ||
          isAuthenticated()
        );
      allow list: if isTeacher() || isAdmin();
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() ||
        (isParent() &&
          resource.data.get('type', 'student') != 'class' &&
          resource.data.used == false &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedBy', 'usedAt']) &&
          request.resource.data.used == true &&
          request.resource.data.usedBy == request.auth.uid);
    }

    // Veli: yalnızca kendi öğrencilerine atanmış ödev (studentIds). Liste enumeration kapalı.
    match /homeworks/{homeworkId} {
      allow get: if isAdmin() ||
        teacherOwnsResource() ||
        parentCanReadHomework();
      allow list: if isAdmin() || isTeacher();
      allow create: if teacherOwnsCreate() &&
        request.resource.data.keys().hasAll(['studentIds']) &&
        request.resource.data.studentIds is list;
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /homework_assignments/{assignmentId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /exam_results/{examId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /subject_progress/{progressId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /goals/{goalId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && request.auth.uid in resource.data.parentIds);
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /admin_broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
