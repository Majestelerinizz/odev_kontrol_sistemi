rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcı fonksiyonlar ──────────────────────────────────────────────

    // Kullanıcı oturum açmış mı?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Kullanıcı kim olduğunu doğrula
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Öğretmen mi?
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }

    // Veli mi?
    function isParent() {
      return isAuthenticated() && getUserRole() == 'parent';
    }

    // Kendi kaydı mı?
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Öğretmen bu öğrenciye sahip mi?
    function isTeacherOfStudent(studentId) {
      return isTeacher() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid;
    }

    // Veli bu öğrenciye bağlı mı?
    function isParentOfStudent(studentId) {
      return isParent() &&
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.parentIds;
    }

    // ── users koleksiyonu ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // Hesap silme Cloud Functions üzerinden yapılır
    }

    // ── teacher_profiles koleksiyonu ───────────────────────────────────────
    match /teacher_profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ── parent_profiles koleksiyonu ────────────────────────────────────────
    match /parent_profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ── classes koleksiyonu ────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isAuthenticated() &&
        (resource.data.teacherId == request.auth.uid || isTeacher());
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── students koleksiyonu ───────────────────────────────────────────────
    match /students/{studentId} {
      // Öğretmen kendi öğrencilerini yönetebilir
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                      (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds']));
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      // Veli yalnızca bağlı öğrencisini okuyabilir
      allow read: if isParentOfStudent(studentId);
    }

    // ── invite_codes koleksiyonu ───────────────────────────────────────────
    match /invite_codes/{code} {
      // Veliler kayıt olmadan önce davet kodunu doğrular (oturum açılmamış olabilir)
      allow read: if true;
      allow create: if isTeacher();
      allow update: if true;
    }

    // ── homeworks koleksiyonu ──────────────────────────────────────────────
    match /homeworks/{homeworkId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ── homework_assignments koleksiyonu ───────────────────────────────────
    match /homework_assignments/{assignmentId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      // Veli yalnızca bağlı öğrencisinin ödevlerini görebilir
      allow read: if isParentOfStudent(resource.data.studentId);
    }

    // ── exam_results koleksiyonu ───────────────────────────────────────────
    match /exam_results/{examId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      allow read: if isParentOfStudent(resource.data.studentId);
    }

    // ── subject_progress koleksiyonu ───────────────────────────────────────
    match /subject_progress/{progressId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      allow read: if isParentOfStudent(resource.data.studentId);
    }

    // ── goals koleksiyonu ──────────────────────────────────────────────────
    match /goals/{goalId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      allow read: if isParentOfStudent(resource.data.studentId);
    }

    // ── messages koleksiyonu ───────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;

      // Veli yalnızca kendisine gönderilen mesajları okuyabilir
      allow read: if isParent() &&
        request.auth.uid in resource.data.parentIds;
    }

    // ── notifications koleksiyonu ──────────────────────────────────────────
    match /notifications/{notificationId} {
      // Yalnızca hedef kullanıcı kendi bildirimlerini okuyabilir
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Öğretmen bildirim oluşturabilir (Cloud Functions üzerinden tercih edilir)
      allow create: if isTeacher();
      // Okundu işareti — yalnızca hedef kullanıcı
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

  }
}
